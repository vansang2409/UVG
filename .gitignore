.venv/
__pycache__/
*.pyc
.env
*.zip
!/data/Bo sung/meInvoice/2026-10-11-pending-XML/*.zip

# Giữ dữ liệu gốc tại thư mục dự án; bản đưa lên Git nằm trong data/.
/Du lieu Amis/
/Du lieu Meinvoice/

# File tạm khi kiểm tra/bố trí Excel; chỉ giữ builder đang dùng.
node_modules/
~$*
*.inspect.ndjson
/scripts/data/invoice_reports.json
/scripts/data/*.png
/scripts/layout-tools/*
!/scripts/layout-tools/build-adjusted.mjs
/outputs/**/_build/
/outputs/ngoai-le-meinvoice-2024/NGOAI_LE_2024_THEO_CHUOI.xlsx

# Snapshot/preview/log cục bộ; bàn giao workbook chính, script và JSON căn cứ.
/scripts/data/check-review/*.xlsx
/scripts/data/check-review/*.png
/scripts/data/check-review/*.log
/scripts/data/untreated/*.xlsx
/scripts/data/untreated/*.png
/scripts/data/untreated/*.log

# Bản xuất trung gian và ảnh kiểm tra của đợt chốt kế toán.
# Giữ before/ làm căn cứ so sánh độc lập khi kiểm tra trên máy khác.
/scripts/data/apply-confirmed-20261012/staged/
/scripts/data/apply-confirmed-20261012/previews/
/scripts/data/apply-confirmed-20261012/*.ndjson
/scripts/data/apply-confirmed-20261012/*.flag
/scripts/data/check-review/kt-workbook-20261011/previews/
/scripts/data/check-review/kt-workbook-20261011/confirmed-previews/
/scripts/data/check-review/kt-workbook-20261011/*.ndjson
